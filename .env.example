# Employee Management System — environment template
# Copy to `.env` and fill in real values: cp .env.example .env

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database (required) -----------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_management?schema=public"

# --- Auth (required) ---------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=1d

# Cost factor for bcrypt password hashing.
BCRYPT_SALT_ROUNDS=10

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins, or `*` for any.
CORS_ORIGIN=*

# --- Seed manager account ----------------------------------------------------
# Used by `npm run seed`. Change these before any real deployment.
SEED_MANAGER_NAME="System Manager"
SEED_MANAGER_EMAIL=manager@company.com
SEED_MANAGER_PASSWORD=Manager@123
